GOOGLE_PROJECT_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Manager (MCC) account ID, if accessing client accounts through one.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# OAuth proxy mode (hosted, Streamable HTTP).
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=
# Local stdio runs: unset the two OAuth variables above and point this at an
# authorized_user ADC JSON, e.g. an absolute path to .secrets/adc.json.
GOOGLE_APPLICATION_CREDENTIALS=
